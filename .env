# This is a .env file where you should add sensitive data.
# It is important to note that this file should not be shared or committed to version control systems, as it contains sensitive information such as API keys, passwords, and other credentials.
# Make sure to replace the placeholders in this file with the actual sensitive data required by your application.
# Keeping this file secure is crucial to protect your application and its data from unauthorized access.

#Important!!!: This file should be renamed to .env

# Discord Bot Token
# Replace the value below with your bot token on your local machine only.
# DO NOT commit the real token to GitHub or any public repo.
DISCORD_TOKEN=MTUzMTcyODAyODM1NzQ5MzAxNw.Gp0hnF.Obrini7buR6Ix4uj0r01QGuIOqczcvUHyBxfAk

# Guild ID (optional, used for registering commands to a single guild)
# Rename to GUILD_ID to match the code (config.js reads GUILD_ID)
GUILD_ID=YOUR_GUILD_ID_HERE

# Application (Client) ID (optional)
APPLICATION_ID=YOUR_APPLICATION_ID_HERE

# Your Discord User ID (bot owner)
OWNER_ID=YOUR_DISCORD_USER_ID_HERE

# ── AI Chat (Google Gemini) ──────────────────────────────────────────────────
# Get a FREE key at: https://aistudio.google.com/  (click "Get API Key")
# Then set the AI chat channel with /setaichannel in your Discord server
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
